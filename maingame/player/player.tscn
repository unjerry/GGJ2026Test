[sub_resource type="GDScript" id="GDScript_rgyib"]
script/source = "extends Sprite2D

func UpdateAlpha(newValue: float):
	modulate.a = newValue
	

func StartFading():
	var newTween = get_tree().create_tween()
	newTween.tween_method(UpdateAlpha, 0.2, 0.0, 0.5)
"

